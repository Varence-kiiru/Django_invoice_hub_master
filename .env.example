# Copy to .env and update the values for your environment

# Django
DJANGO_SECRET_KEY=replace-me-local
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
MYSQL_DATABASE=invoice_app
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# CORS (comma separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email / anymail provider (example)
ANYMAIL_API_KEY=
ANYMAIL_PROVIDER=sendgrid
# Copy this file to .env and update values for your environment
SECRET_KEY=change-me-in-production
DEBUG=True
DB_NAME=invoice_app
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Comma-separated list for allowed hosts and CSRF trusted origins (used when DEBUG=False)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.olivian.co.ke
EMAIL_PORT=465
EMAIL_HOST_USER=admin@olivian.co.ke
EMAIL_HOST_PASSWORD=Olivian@2024
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=admin@olivian.co.ke

# M-Pesa Configuration (Safaricom Daraja API)
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=http://127.0.0.1:8000/api/payments/mpesa-callback/
MPESA_ENVIRONMENT=sandbox

# Celery Configuration (optional, for async tasks)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0