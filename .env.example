# Environment Configuration Template for InvoiceSystem
# Copy to .env and update with your actual values

# ============================================================================
# DJANGO CORE CONFIGURATION
# ============================================================================

DJANGO_SECRET_KEY=replace-me-local
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
DEBUG=False

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

MYSQL_DATABASE=invoice_app
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ============================================================================
# STRIPE PAYMENT PROCESSING (NEW - COMMERCIALIZATION)
# ============================================================================

# Stripe API Secret Key (get from: Stripe Dashboard → Developers → API Keys)
STRIPE_API_KEY=sk_test_YOUR_TEST_KEY_HERE

# Stripe Public Key (get from: Stripe Dashboard → Developers → API Keys)
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_KEY_HERE

# Stripe Webhook Secret (get from: Stripe Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_WEBHOOK_SECRET_HERE

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.your_sendgrid_api_key_here
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# CORS & SECURITY (NEW - COMMERCIALIZATION)
# ============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000
SECURITY_MIDDLEWARE_ENABLED=True

# ============================================================================
# REDIS CACHE & MESSAGE BROKER
# ============================================================================

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ============================================================================
# AWS S3 CONFIGURATION (Optional - for media storage)
# ============================================================================

AWS_S3_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# MONITORING & ERROR TRACKING (New - Recommended for Production)
# ============================================================================

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# LOGGING & INTERNATIONALIZATION
# ============================================================================

LOG_LEVEL=INFO
LANGUAGE_CODE=en-us
TIME_ZONE=Africa/Nairobi

# ============================================================================
# API CONFIGURATION
# ============================================================================

DRF_PAGE_SIZE=25
DRF_MAX_PAGE_SIZE=1000
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ============================================================================
# MULTI-TENANCY CONFIGURATION (New - Commercialization)
# ============================================================================

MULTI_TENANCY_ENABLED=True
ORGANIZATION_REQUIRED_APPS=invoicing_app.invoices,invoicing_app.deliveries

# ============================================================================
# OPTIONAL: M-PESA Payment (Alternative to Stripe)
# ============================================================================

MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_ENVIRONMENT=sandbox

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================

# DEVELOPMENT MODE:
# - DEBUG=True
# - Use sk_test_* and pk_test_* Stripe keys
# - SECURE_SSL_REDIRECT=False
# - No need for SSL certificate

# PRODUCTION MODE:
# - DEBUG=False
# - Use sk_live_* and pk_live_* Stripe keys (from live environment)
# - SECURE_SSL_REDIRECT=True
# - Get SSL certificate from Let's Encrypt (free)
# - Always use HTTPS
# - Generate new DJANGO_SECRET_KEY
# - Store this file securely, NOT in version control

# ============================================================================
# STRIPE TEST CARDS (Development Only)
# ============================================================================

# Success: 4242 4242 4242 4242
# Declined: 4000 0000 0000 0002
# Visa/Mastercard: 5555 5555 5555 4444
# Expiry: Any future date (e.g., 12/25)
# CVC: Any 3 digits

# ============================================================================
# QUICK START COMMANDS
# ============================================================================

# 1. Create .env from this file:
#    cp .env.example .env
#
# 2. Update values in .env (Stripe keys, database password, etc.)
#
# 3. Run migrations:
#    python manage.py migrate organizations
#
# 4. Create admin:
#    python manage.py createsuperuser
#
# 5. Test server:
#    python manage.py runserver
#
# 6. Access admin:
#    http://localhost:8000/admin/
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
